# top-level EditorConfig (https://editorconfig.org)
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2          # same as Prettier default
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true


[{*.md,LICENSE}]
trim_trailing_whitespace = false   # keep spaces in markdown tables