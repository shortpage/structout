###############################################################################
# File   : .env.demo
# Author : Sesh Ragavachari
# Date   : 2025-07-18
# Version: 1.0
#
# Purpose
#   Example environment file used by the Vite-powered frontend when running
#   in “demo” mode.
#
#   • VITE_DEMO_READ_ONLY — When set to “1” the UI disables all mutating
#     actions, preventing accidental changes while showcasing the product.
#   • VITE_SHOW_TOUR      — Toggles the built-in product tour (0 = hidden,
#     1 = show on first load).
#
# Usage
#   1. Copy this file to `.env` or `.env.local`.
#   2. Adjust values as necessary.
#   3. **Never** commit real secrets to version control.
###############################################################################
VITE_DEMO_READ_ONLY=1
VITE_SHOW_TOUR=0
